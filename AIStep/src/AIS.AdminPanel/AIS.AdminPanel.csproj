    <ItemGroup>
        <ProjectReference Include="..\AIS.Domain\AIS.Domain.csproj" />
        <ProjectReference Include="..\AIS.Infrastructure\AIS.Infrastructure.csproj" />
    </ItemGroup>

</Project>
