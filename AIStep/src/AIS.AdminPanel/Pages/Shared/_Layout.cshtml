<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] — AIStep Admin</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/AIS.AdminPanel.styles.css" asp-append-version="true"/>
</head>
<body class="ais-body">

@if (User.Identity?.IsAuthenticated ?? false)
{
    <div class="ais-layout">
        <!-- Sidebar -->
        <aside class="ais-sidebar">
            <div class="ais-sidebar-brand">
                <i class="bi bi-activity me-2"></i>AIStep Admin
            </div>
            <nav class="ais-nav">
                <a class="ais-nav-link @(Context.Request.Path == "/" || Context.Request.Path == "/Index" ? "active" : "")" asp-page="/Index">
                    <i class="bi bi-grid-fill"></i> Дашборд
                </a>
                <a class="ais-nav-link @(Context.Request.Path.StartsWithSegments("/Users") || Context.Request.Path.StartsWithSegments("/UserEdit") ? "active" : "")" asp-page="/Users">
                    <i class="bi bi-people-fill"></i> Пользователи
                </a>
                <a class="ais-nav-link @(Context.Request.Path.StartsWithSegments("/Meals") || Context.Request.Path.StartsWithSegments("/MealEdit") ? "active" : "")" asp-page="/Meals">
                    <i class="bi bi-egg-fried"></i> Блюда
                </a>
                <a class="ais-nav-link @(Context.Request.Path.StartsWithSegments("/Admins") || Context.Request.Path.StartsWithSegments("/AdminCreate") ? "active" : "")" asp-page="/Admins">
                    <i class="bi bi-shield-lock-fill"></i> Администраторы
                </a>
            </nav>
            <div class="ais-sidebar-footer">
                <div class="ais-user-info">
                    <i class="bi bi-person-circle me-2"></i>
                    <span class="ais-user-email">@User.Identity?.Name</span>
                </div>
                <a href="@Url.Page("/Logout")" class="ais-logout-btn">
                    <i class="bi bi-box-arrow-right me-1"></i> Выйти
                </a>
            </div>
        </aside>

        <!-- Main content -->
        <main class="ais-main">
            @RenderBody()
        </main>
    </div>
}
else
{
    <main>
        @RenderBody()
    </main>
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

