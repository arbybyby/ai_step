@page
@model MealsModel
@{
    ViewData["Title"] = "Управление блюдами";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1>Управление блюдами</h1>
                <a href="@Url.Page("/MealEdit")" class="btn btn-success">
                    <i class="bi bi-plus-circle"></i> Добавить блюдо
                </a>
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @Model.ErrorMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @Model.SuccessMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (Model.Meals.Count == 0)
            {
                <div class="alert alert-info">
                    Нет добавленных блюд. <a href="@Url.Page("/MealEdit")">Добавьте первое блюдо</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Название</th>
                                <th>Тип</th>
                                <th>Калории</th>
                                <th>Белки</th>
                                <th>Углеводы</th>
                                <th>Жиры</th>
                                <th>Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var meal in Model.Meals)
                            {
                                <tr>
                                    <td>@meal.Id</td>
                                    <td>@meal.MealName</td>
                                    <td>
                                        <span class="badge bg-info">@meal.MealType</span>
                                    </td>
                                    <td>@meal.Calories</td>
                                    <td>@meal.Protein</td>
                                    <td>@meal.Carbs</td>
                                    <td>@meal.Fat</td>
                                    <td>
                                        <a href="@Url.Page("/MealEdit", new { id = meal.Id })" class="btn btn-sm btn-primary">
                                            <i class="bi bi-pencil"></i> Редактировать
                                        </a>
                                        <form method="post" asp-page-handler="Delete" style="display:inline;">
                                            <input type="hidden" name="id" value="@meal.Id" />
                                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Вы уверены?')">
                                                <i class="bi bi-trash"></i> Удалить
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="mt-4">
                <a href="@Url.Page("/Index")" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Назад на главную
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .table-responsive {
        border-radius: 0.5rem;
        overflow: hidden;
    }
</style>

