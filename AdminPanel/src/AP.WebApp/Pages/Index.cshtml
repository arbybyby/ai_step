@page
@model IndexModel

<style>
    body {
        background: linear-gradient(135deg, #f0f9f7 0%, #e8f5f1 100%);
    }

    .page-header {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: white;
        padding: 2rem;
        border-radius: 12px;
        margin-bottom: 2rem;
        box-shadow: 0 4px 6px rgba(16, 185, 129, 0.1);
    }

        .page-header h1 {
            margin: 0;
            font-size: 2rem;
            font-weight: 600;
        }

    .table-container {
        background: white;
        border-radius: 12px;
        padding: 1.5rem;
        box-shadow: 0 2px 8px rgba(16, 185, 129, 0.08);
        overflow-x: auto;
    }

    .table {
        margin: 0;
    }

        .table thead {
            background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%);
            border-bottom: 2px solid #10b981;
        }

            .table thead th {
                color: #047857;
                font-weight: 600;
                padding: 1rem;
                border-color: #10b981;
            }

            .table thead th.sortable {
                cursor: pointer;
                user-select: none;
            }

            .table thead th.sortable:hover {
                background-color: #a7f3d0;
            }

            .table thead th.sortable::after {
                content: " ↕️";
                font-size: 0.875rem;
                opacity: 0.5;
            }

            .table thead th.sortable.active-asc::after {
                content: " ↑";
                opacity: 1;
            }

            .table thead th.sortable.active-desc::after {
                content: " ↓";
                opacity: 1;
            }

        .table tbody tr {
            border-bottom: 1px solid #d1fae5;
            transition: background-color 0.2s ease;
        }

            .table tbody tr:hover {
                background-color: #f0fdf4;
            }

        .table tbody td {
            padding: 1rem;
            color: #1f2937;
        }

    .btn-delete {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        color: white;
        border: none;
        padding: 0.5rem 1rem;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 500;
        transition: all 0.3s ease;
        font-size: 0.875rem;
    }

        .btn-delete:hover {
            background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(239, 68, 68, 0.3);
        }

        .btn-delete:active {
            transform: translateY(0);
        }

    .no-users {
        text-align: center;
        padding: 3rem;
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(16, 185, 129, 0.08);
    }

        .no-users p {
            color: #6b7280;
            font-size: 1.1rem;
            margin: 0;
        }
</style>

<div class="page-header">
    <h1>👥 Пользователи</h1>
</div>

@if (Model.Users.Any())
{
    <div class="table-container">
        <table class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Email</th>
                    <th>Имя</th>
                    <th>Фамилия</th>
                    <th>Дата создания</th>
                    <th class="sortable @(Model.SortOrder == "steps_asc" ? "active-asc" : Model.SortOrder == "steps_desc" ? "active-desc" : "")">
                        <a asp-page="Index" asp-route-sortOrder="@(Model.SortOrder == "steps_asc" ? "steps_desc" : "steps_asc")" style="color: inherit; text-decoration: none;">
                            Шаги
                        </a>
                    </th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td>@user.Id</td>
                        <td>@user.Email</td>
                        <td>@user.FirstName</td>
                        <td>@user.LastName</td>
                        <td>@user.CreatedAt?.ToString("dd.MM.yyyy")</td>
                        <td>
                            @{
                                var dailySteps = Model.DailyStepsResults.Where(x => x.UserId == user.Id).ToList();
                                if (dailySteps.Any())
                                {
                                    @dailySteps[0].TotalSteps;
                                }
                                else
                                {
                                    <span>0</span>
                                }
                            }
                        </td>
                        <td>
                            <form method="post" asp-page-handler="Delete" style="display: inline;">
                                <input type="hidden" name="userId" value="@user.Id" />
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-delete" onclick="return confirm('Вы уверены, что хотите удалить этого пользователя?');">
                                    🗑️ Удалить
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="no-users">
        <p>Пользователей не найдено.</p>
    </div>
}