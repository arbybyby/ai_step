@page
@model AdminCreateModel
@{
    ViewData["Title"] = "Добавление администратора";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="d-flex align-items-center mb-4 gap-3">
                <a href="@Url.Page("/Admins")" class="btn btn-ais-outline">
                    <i class="bi bi-arrow-left me-1"></i> Назад
                </a>
                <h1 class="ais-title mb-0"><i class="bi bi-person-plus-fill me-2"></i>Добавление администратора</h1>
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="ais-card shadow-lg">
                <div class="ais-card-header">
                    <i class="bi bi-shield-lock-fill me-2"></i>Данные нового администратора
                </div>
                <div class="ais-card-body">
                    <form method="post">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="AdminRequest.FirstName" class="ais-label">Имя <span class="text-danger">*</span></label>
                                <input asp-for="AdminRequest.FirstName" class="ais-input" placeholder="Имя" />
                                <span asp-validation-for="AdminRequest.FirstName" class="ais-validation"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="AdminRequest.LastName" class="ais-label">Фамилия <span class="text-danger">*</span></label>
                                <input asp-for="AdminRequest.LastName" class="ais-input" placeholder="Фамилия" />
                                <span asp-validation-for="AdminRequest.LastName" class="ais-validation"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="AdminRequest.Email" class="ais-label">Email <span class="text-danger">*</span></label>
                            <input asp-for="AdminRequest.Email" class="ais-input" placeholder="admin@example.com" />
                            <span asp-validation-for="AdminRequest.Email" class="ais-validation"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="AdminRequest.Password" class="ais-label">Пароль <span class="text-danger">*</span></label>
                            <input asp-for="AdminRequest.Password" type="password" class="ais-input" placeholder="Минимум 6 символов" />
                            <span asp-validation-for="AdminRequest.Password" class="ais-validation"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="AdminRequest.ConfirmPassword" class="ais-label">Подтверждение пароля <span class="text-danger">*</span></label>
                            <input asp-for="AdminRequest.ConfirmPassword" type="password" class="ais-input" placeholder="Повторите пароль" />
                            <span asp-validation-for="AdminRequest.ConfirmPassword" class="ais-validation"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-ais">
                                <i class="bi bi-person-check-fill me-1"></i> Создать администратора
                            </button>
                            <a href="@Url.Page("/Admins")" class="btn btn-ais-outline">Отмена</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

