@page
@using System.Security.Claims
@model AdminsModel
@{
    ViewData["Title"] = "Управление администраторами";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="ais-title"><i class="bi bi-shield-lock-fill me-2"></i>Администраторы</h1>
        <div class="d-flex gap-2">
            <a asp-page="/AdminCreate" class="btn btn-ais">
                <i class="bi bi-person-plus-fill me-1"></i> Добавить администратора
            </a>
            <a href="@Url.Page("/Index")" class="btn btn-ais-outline">
                <i class="bi bi-arrow-left me-1"></i> На главную
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert ais-alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Admins.Count == 0)
    {
        <div class="ais-empty-state">
            <i class="bi bi-shield-x display-4 mb-3"></i>
            <p>Администраторы не найдены</p>
        </div>
    }
    else
    {
        <div class="ais-card">
            <div class="ais-card-header">
                <span><i
                        class="bi bi-list-ul me-2"></i>Всего администраторов: <strong>@Model.Admins.Count</strong></span>
            </div>
            <div class="table-responsive">
                <table class="table ais-table mb-0">
                    <thead>
                    <tr>
                        <th>ID</th>
                        <th>Имя</th>
                        <th>Фамилия</th>
                        <th>Email</th>
                        <th>Действия</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var admin in Model.Admins)
                    {
                        <tr>
                            <td><span class="ais-id-badge">#@admin.Id</span></td>
                            <td>@admin.FirstName</td>
                            <td>@admin.LastName</td>
                            <td>@admin.Email</td>
                            <td>
                                @{
                                    if (@User.FindFirstValue(ClaimTypes.NameIdentifier) != Convert.ToString(@admin.Id))
                                    {
                                        <form method="post" asp-page-handler="Delete" asp-route-id="@admin.Id"
                                              onsubmit="return confirm('Вы уверены, что хотите удалить администратора @admin.FirstName @admin.LastName?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger">
                                                <i class="bi bi-trash-fill me-1"></i>Удалить
                                            </button>
                                        </form>
                                    }
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

