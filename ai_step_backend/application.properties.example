spring.application.name=ai_step_backend

# Server Configuration
server.port=8082

# Docker Compose
spring.docker.compose.enabled=false

# Disable DataSource auto-configuration
spring.autoconfigure.exclude=org.springframework.boot.autoconfigure.jdbc.DataSourceAutoConfiguration,org.springframework.boot.autoconfigure.orm.jpa.HibernateJpaAutoConfiguration

# Logging configuration
logging.level.com.arbybyby.aistep=DEBUG
logging.level.org.springframework.security=DEBUG
logging.level.org.hibernate.SQL=DEBUG
logging.level.org.hibernate.type.descriptor.sql.BasicBinder=TRACE

# JWT Configuration
app.jwtSecret=myVerySecureSecretKeyThatIsAtLeast32BytesLongForHMACsha256Algorithm
app.jwtExpirationMs=86400000

# Security Configuration
# Set to false to disable JWT authentication temporarily (useful for development/testing)
# When disabled, userID must be provided in request body
app.security.enabled=true

# RabbitMQ Configuration
spring.rabbitmq.host=${RABBITMQ_HOST:localhost}
spring.rabbitmq.port=${RABBITMQ_PORT:5672}
spring.rabbitmq.username=${RABBITMQ_USER:guest}
spring.rabbitmq.password=${RABBITMQ_PASSWORD:guest}