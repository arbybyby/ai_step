@page
@using System.Security.Claims
@model IndexModel
@{
    ViewData["Title"] = "Админ Панель";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1>Админ Панель</h1>
                <div>
                    <span class="me-3">
                        <i class="bi bi-person-circle"></i>
                        @User.Identity?.Name
                    </span>
                    <a href="@Url.Page("/Logout")" class="btn btn-outline-danger btn-sm">
                        <i class="bi bi-box-arrow-right"></i> Выход
                    </a>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Добро пожаловать в админ панель!</h5>
                    <p class="card-text">Вы успешно вошли в систему.</p>
                    <p class="card-text">
                        <small class="text-muted">
                            Ваш email: <strong>@User.FindFirstValue(ClaimTypes.Email)</strong>
                        </small>
                    </p>
                </div>
            </div>

            <div class="row mt-4">
                <div class="col-md-4">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Пользователи</h5>
                            <p class="card-text">Управление пользователями системы</p>
                            <a href="#" class="btn btn-primary btn-sm">Перейти</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Статистика</h5>
                            <p class="card-text">Просмотр статистики</p>
                            <a href="#" class="btn btn-primary btn-sm">Перейти</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Настройки</h5>
                            <p class="card-text">Конфигурация системы</p>
                            <a href="#" class="btn btn-primary btn-sm">Перейти</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

