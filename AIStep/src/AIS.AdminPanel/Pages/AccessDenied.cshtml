@page
@model AIS.AdminPanel.Pages.AccessDeniedModel
@{
    ViewData["Title"] = "Доступ запрещен";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="alert alert-danger" role="alert">
                <h4 class="alert-heading">Доступ запрещен!</h4>
                <p>У вас нет прав доступа к этому ресурсу.</p>
                <hr>
                <p class="mb-0">
                    <a href="@Url.Page("/Index")" class="btn btn-primary">Вернуться на главную</a>
                </p>
            </div>
        </div>
    </div>
</div>

