@page
@using System.Security.Claims
@model IndexModel
@{
    ViewData["Title"] = "Дашборд";
}

<h1 class="ais-title mb-4"><i class="bi bi-grid-fill me-2"></i>Дашборд</h1>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <a href="@Url.Page("/Users")" class="ais-stat-card">
            <div class="ais-stat-icon">
                <i class="bi bi-people-fill"></i>
            </div>
            <div>
                <div class="ais-stat-label">Раздел</div>
                <div class="ais-stat-value">Пользователи</div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a href="@Url.Page("/Meals")" class="ais-stat-card">
            <div class="ais-stat-icon">
                <i class="bi bi-egg-fried"></i>
            </div>
            <div>
                <div class="ais-stat-label">Раздел</div>
                <div class="ais-stat-value">Блюда</div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a href="@Url.Page("/Admins")" class="ais-stat-card">
            <div class="ais-stat-icon">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <div>
                <div class="ais-stat-label">Раздел</div>
                <div class="ais-stat-value">Администраторы</div>
            </div>
        </a>
    </div>
</div>

<div class="ais-card">
    <div class="ais-card-header">
        <i class="bi bi-info-circle me-2"></i>Информация о сессии
    </div>
    <div class="ais-card-body">
        <p class="mb-1"><strong>Администратор:</strong> @User.Identity?.Name</p>
        <p class="mb-0 text-muted" style="font-size:0.85rem;">
            Email: @User.FindFirstValue(ClaimTypes.Email)
        </p>
    </div>
</div>
